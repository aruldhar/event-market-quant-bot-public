        "event_utc TEXT NOT NULL",
        "event_monotonic_ns INTEGER",
        "event_type TEXT NOT NULL",
        "severity TEXT NOT NULL",
        "payload_json TEXT NOT NULL",
        "UNIQUE(session_id,session_event_seq)"
